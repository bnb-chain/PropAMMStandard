# Copy to .env and fill in. .env is gitignored — never commit secrets (PKs).
# cp .env.example .env

# ===== Chain / endpoints =====
CHAIN_ID=56
# The relayer node's HTTP RPC. Must expose the pamm namespace alongside eth:
#   geth --propamm --http --http.api eth,net,web3,pamm ...
RELAYER_RPC=https://propamm.bnbchain.org
# Optional WS endpoint; the maker prefers it when set (many in-flight calls on
# one connection). Overlay snapshot subscribe (pamm_subscribe) requires WS.
# Needs --ws --ws.api eth,net,web3,pamm.
RELAYER_WS=
# RPC for plain chain reads (nonce, block number, receipts) and the two-tx
# push. Defaults to RELAYER_RPC, but a relayer deployment may restrict
# non-PropAMM methods (BAP-710 §4.5): set an ordinary BSC RPC here.
PUBLIC_RPC=
# Optional: a VANILLA node's RPC (no relayer) to show the counterfactual —
# eth_call there sees no overlay, so the same quote read reverts NoPrice /
# StaleUpdate or returns the stale on-chain price. Empty = skip the comparison.
COMPARE_RPC=

# ===== Contract addresses (see README §2) =====
# ORACLE = PrioUpdateRegistry (v2: seq-protected lanes, no freshness in the
# registry), ROUTER = ExamplePammRouter (push-payment IPropAMM pool)
ORACLE=0x4EaBe41ccAEcdbb16b7CE67D893E698757D2C9AD
ROUTER=
# Optional: ExamplePammTaker address. Set it to fill in ONE tx (transferFrom
# into the pool + swap); the taker EOA must approve it for TOKEN_IN, and a
# pool with a taker allowlist must allowlist the contract. Empty = the wallet
# pushes with a separate transfer tx first.
TAKER_CONTRACT=

# ===== Trading pair =====
# Default tokenIn = BSC USDT (18d), tokenOut = BSC WBNB (18d)
TOKEN_IN=0x55d398326f99059fF775485246999027B3197955
TOKEN_OUT=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# ===== Console API keys (leave empty against an open relayer) =====
# A relayer started with --propamm.console.url authenticates every caller by
# the API key in x-api-key, resolved in memory against the console's
# permission snapshot. Quotes need a valid maker key; every taker sees public
# makers, and a valid taker key adds the restricted makers that ticked it.
MAKER_API_KEY=
TAKER_API_KEY=

# ===== Private keys (TEST ONLY — never commit) =====
# Maker must be an authorized updater of ROUTER on the registry
# (router.addMaker), and hold enough BNB to pass the gas balance check in the
# relayer's next-block simulation (gas is only really spent when a fill lands
# the quote tx on chain).
MAKER_PK=
# Taker needs BNB for gas and a TOKEN_IN balance. No approval: the router is
# push-payment, the taker transfers amountIn to it first, then calls swap.
TAKER_PK=

# ===== Maker quote params =====
# Price: 1e18-scaled "how much tokenOut 1 tokenIn buys", directional per lane
# (tokenIn -> tokenOut): amountOut = amountIn * price / 1e18.
# Example: USDT -> WBNB at 900 USDT per WBNB => 1e18/900 ≈ 1111111111111111.
QUOTE_PRICE=1111111111111111
# Random jitter per round (basis points), to make price changes observable
QUOTE_JITTER_BPS=5
QUOTE_INTERVAL_MS=3000
# 0 = head + 100 (relayer clamps to its --propamm.maxquotelife anyway)
QUOTE_MAX_BLOCK_NUMBER=0
MAKER_GAS_LIMIT=120000
MAKER_GAS_PRICE=1000000000
# 1 = also publish accepted quotes through the public txpool (Base-style
# visibility). Needs bumped/rotated nonces to avoid "replacement underpriced";
# leave 0 for the default relayer-internal flow.
UPDATE_ONCHAIN=0
# 1 = send a cancel (empty tx) for the stream uuid on Ctrl-C
MAKER_CANCEL_ON_EXIT=1

# ===== Taker fill params =====
TAKER_AMOUNT_IN=1000000000000000000
# 0 = derive minOut from the simulated amountOut minus TAKER_SLIPPAGE_BPS
TAKER_MIN_OUT=0
# The relayer bundles the maker's LATEST resting quote, not the frame you
# simulated, so 0 bps reverts on any adverse tick. Default 50 = 0.50%.
TAKER_SLIPPAGE_BPS=50
# Only fill when simulated amountOut >= this threshold; 0 = always
TAKER_TAKE_THRESHOLD=0
TAKER_GAS_LIMIT=200000
TAKER_GAS_PRICE=10000000000
# Poll interval for the eth_call pricing loop
TAKER_POLL_MS=1500
# Send only once per distinct simulated price; 0 = every poll
TAKER_DEDUP=1
# dry run: only simulate + sign, do NOT send the tx; 1 = on, 0 = send for real
TAKER_DRY_RUN=1
# After sending, watch for landing this many blocks before giving up
TAKER_WATCH_BLOCKS=120
# 1 = keep polling/filling after a live send resolves; 0 = fire once and exit
TAKER_LOOP=0
